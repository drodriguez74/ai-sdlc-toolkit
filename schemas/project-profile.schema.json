{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Project Profile",
  "type": "object",
  "required": ["project_root", "detected_at"],
  "properties": {
    "project_root": {"type": "string"},
    "detected_at":  {"type": "string"},
    "languages":    {"type": "array", "items": {"type": "string"}},
    "frameworks":   {"type": "array", "items": {"type": "string"}},
    "build_tools":  {"type": "array", "items": {"type": "string"}},
    "test_frameworks": {"type": "array", "items": {"type": "string"}},
    "ci_cd":        {"type": "array", "items": {"type": "string"}},
    "infrastructure": {"type": "array", "items": {"type": "string"}},
    "cloud":        {"type": "array", "items": {"type": "string"}},
    "api_contracts": {"type": "array", "items": {"type": "string"}},
    "data_stores":  {"type": "array", "items": {"type": "string"}},
    "docs":         {"type": "array", "items": {"type": "string"}},
    "notes":        {"type": "string"}
  }
}

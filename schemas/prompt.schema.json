{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Prompt Frontmatter",
  "type": "object",
  "required": ["name", "description"],
  "properties": {
    "name":        {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "description": {"type": "string", "minLength": 1},
    "skills":      {"type": "array", "items": {"type": "string"}},
    "agent":       {"type": "string"}
  }
}

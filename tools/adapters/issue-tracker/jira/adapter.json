{
  "name": "jira",
  "domain": "issue-tracker",
  "commands": {
    "health":  "scripts/issue_search.py --help",
    "search":  "scripts/issue_search.py",
    "read":    "scripts/issue_read.py",
    "create":  "scripts/issue_create.py",
    "update":  null,
    "discover": null
  },
  "env": [
    {"name": "JIRA_BASE_URL", "required": true,  "description": "Jira base URL (e.g., https://your-org.atlassian.net)"},
    {"name": "JIRA_EMAIL",    "required": true,  "description": "Jira account email"},
    {"name": "JIRA_API_TOKEN","required": true,  "description": "Jira API token"}
  ],
  "outputs": {"format": "json", "path": ".ai-sdlc/adapter-out/"}
}

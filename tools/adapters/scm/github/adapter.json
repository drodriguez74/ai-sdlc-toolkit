{
  "name": "github",
  "domain": "scm",
  "commands": {
    "health":            "scripts/pr_read.py --help",
    "pr_read":           "scripts/pr_read.py",
    "pr_review":         "scripts/pr_review.py",
    "release_list":      "scripts/release_list.py",
    "release_create":    "scripts/release_create.py",
    "environment_list":  "scripts/environment_list.py",
    "check_runs":        "scripts/check_runs.py"
  },
  "env": [
    {"name": "GITHUB_TOKEN", "required": true,  "description": "PAT with repo scope; write:releases for release_create"},
    {"name": "GITHUB_REPO",  "required": true,  "description": "owner/repo"}
  ],
  "outputs": {"format": "json", "path": ".ai-sdlc/adapter-out/"}
}
